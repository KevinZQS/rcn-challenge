{
  "uid": "rcn-net",
  "title": "RCN Network Monitoring",
  "tags": ["rcn", "network"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Utilisation by Device",
      "datasource": { "type": "influxdb", "uid": "rcn-influx" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "rcn-influx" },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"cpu\")\n  |> filter(fn: (r) => r._field == \"instant\")\n  |> filter(fn: (r) => r.index == \"ALL\")\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])\n  |> group(columns: [\"device\"])",
          "legendFormat": "{{device}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Interface Operational Status (UP / DOWN)",
      "description": "Each row is one interface. Red segments are link-down events.",
      "datasource": { "type": "influxdb", "uid": "rcn-influx" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 0, "fillOpacity": 90 },
          "mappings": [
            {
              "type": "value",
              "options": {
                "UP": { "text": "UP", "color": "green", "index": 0 },
                "DOWN": { "text": "DOWN", "color": "red", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "rcn-influx" },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"oper_status\")\n  |> keep(columns: [\"_time\", \"_value\", \"device\", \"name\"])\n  |> group(columns: [\"device\", \"name\"])",
          "legendFormat": "{{device}} {{name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Interface Traffic In (bytes/sec)",
      "datasource": { "type": "influxdb", "uid": "rcn-influx" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "rcn-influx" },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"interfaces\")\n  |> filter(fn: (r) => r._field == \"in_octets\")\n  |> group(columns: [\"device\", \"name\"])\n  |> derivative(unit: 1s, nonNegative: true)",
          "legendFormat": "{{device}} {{name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Interface Traffic Out (bytes/sec)",
      "datasource": { "type": "influxdb", "uid": "rcn-influx" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "rcn-influx" },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"interfaces\")\n  |> filter(fn: (r) => r._field == \"out_octets\")\n  |> group(columns: [\"device\", \"name\"])\n  |> derivative(unit: 1s, nonNegative: true)",
          "legendFormat": "{{device}} {{name}}"
        }
      ]
    }
  ]
}
